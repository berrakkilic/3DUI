  m_Script: {fileID: 11500000, guid: 55c6d844b448244128ca0963f774d1a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Magic Wizard
  breadcrumbStoryRole: 2
  dialogueLines:
  - 'Wizard: I expected you.'
  - 'You: I lost my flute... I need it for my concert tonight!'
  - 'Wizard: Yes, yes. Your flute. I know.'
  - 'Wizard: It was stolen!'
  - 'Wizard: Fortunately, I have just the thing. A Potion of Revealing. It should
    lie somewhere around here...'
  - 'Wizard: Drink it, and it will open a portal to bring you a way to your heart''s
    desire.'
  - 'Wizard: In your case... your flute.'
  - 'Wizard: Trust in its power and prepare for battle upon consumption. A beast
    awaits you there.'
  - 'Wizard: Defeat it, and you may recover what was taken from you.'
  - 'Wizard: Ah, right! I gave the last one to that kid doing pushups.'
  - 'Wizard: You''ll have to go get another from the potion stand in the market. '
